-.market-chat{position:fixed;z-index:20;right:16px;bottom:16px;color:#fff}
-.market-chat button{cursor:pointer}
-.market-chat-trigger,.market-chat form button{background:#6631a6;color:white;border:1px solid #bf89f1;border-radius:10px;padding:9px 14px;font-weight:700}
-.market-chat section{position:absolute;bottom:52px;right:0;width:min(360px,calc(100vw - 32px));padding:14px;border:1px solid #9566ba;border-radius:14px;background:#211433;box-shadow:0 12px 32px #0008}
-.market-chat header,.market-chat form{display:flex;justify-content:space-between;align-items:center;gap:8px}
-.market-chat-close{background:none;border:0;color:white;font-size:24px;line-height:1}
-.market-chat section>p{font-size:13px;color:#ddd0ec}
-.market-chat-log{max-height:min(36vh,280px);overflow:auto}
-.market-chat-log p{font-size:14px;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere;background:#352449;border-radius:9px;padding:8px;margin:0 0 8px}
-.market-chat-log .chat-user{background:#513078;margin-left:22px}
-.market-chat form input{flex:1;min-width:0;padding:9px;border:1px solid #9566ba;border-radius:8px;background:#171022;color:white}
-
-.market-chat-trigger{display:grid;place-items:center;width:48px;height:48px;padding:0;border-radius:50%}
-.market-chat-icon{position:relative;display:block;width:21px;height:16px;border:2px solid currentColor;border-radius:7px}
-.market-chat-icon::after{content:"";position:absolute;left:3px;bottom:-5px;width:6px;height:6px;background:#6631a6;border-left:2px solid currentColor;border-bottom:2px solid currentColor;transform:skewY(-30deg)}
-.market-chat section{bottom:58px}
